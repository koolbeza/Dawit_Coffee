# API URL for the Django backend
# Development default: http://127.0.0.1:8000
# Production: set to your deployed backend URL (e.g. https://your-api.onrender.com)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Admin panel session token — set a strong random secret
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_TOKEN=your-secret-token-here
